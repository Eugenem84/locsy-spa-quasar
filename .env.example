# Пример переменных окружения фронтенда Locsy.
# Скопируйте в .env и подставьте свои ключи из кабинета разработчика Яндекса
# (сервис «JavaScript API и Geocoder»). Это ДВА разных ключа.

# Ключ Геокодера — обратное геокодирование адресов локаций
YANDEX_MAPS_API_KEY=

# Ключ JavaScript API 3 — им рисуется карта
YANDEX_MAPS_JS_API_KEY=
